{
 "_comment": "Plain-language explanations for well-known folders and files in the disk map. First match wins; patterns use env vars, ~ and * (one path segment). 'id' selects the text 'disk.k_<id>' in the locale files; 'safety' is keep (don't touch), careful (only through the app/setting named in the text), user (your own files), or clean (OpenSweep can clean it); 'page' links to an OpenSweep page.",
 "paths": [
  {"id": "package_cache", "match": ["%LOCALAPPDATA%\\Package Cache", "%ProgramData%\\Package Cache"], "safety": "careful"},
  {"id": "node_modules", "match": ["*\\node_modules"], "safety": "careful"},
  {"id": "git", "match": ["*\\.git"], "safety": "careful"},
  {"id": "pycache", "match": ["*\\__pycache__"], "safety": "careful"},
  {"id": "venv", "match": ["*\\.venv", "*\\venv"], "safety": "careful"},
  {"id": "driver_extract", "match": ["*:\\Intel", "*:\\AMD", "*:\\NVIDIA", "*:\\SWSetup"], "safety": "careful"},
  {"id": "pagefile", "match": ["%SystemDrive%\\pagefile.sys", "*:\\pagefile.sys"], "safety": "careful"},
  {"id": "hiberfil", "match": ["%SystemDrive%\\hiberfil.sys"], "safety": "careful"},
  {"id": "swapfile", "match": ["%SystemDrive%\\swapfile.sys"], "safety": "keep"},
  {"id": "winsxs", "match": ["%SystemRoot%\\WinSxS"], "safety": "careful"},
  {"id": "installer", "match": ["%SystemRoot%\\Installer"], "safety": "keep"},
  {"id": "updates", "match": ["%SystemRoot%\\SoftwareDistribution"], "safety": "clean", "page": "clean"},
  {"id": "windows_temp", "match": ["%SystemRoot%\\Temp"], "safety": "clean", "page": "clean"},
  {"id": "windows", "match": ["%SystemRoot%"], "safety": "keep"},
  {"id": "windows_old", "match": ["%SystemDrive%\\Windows.old"], "safety": "careful"},
  {"id": "restore", "match": ["*:\\System Volume Information"], "safety": "careful"},
  {"id": "recycle", "match": ["*:\\$Recycle.Bin"], "safety": "clean", "page": "clean"},
  {"id": "recovery", "match": ["*:\\Recovery", "*:\\Boot", "*:\\EFI"], "safety": "keep"},
  {"id": "temp", "match": ["%TEMP%", "~\\AppData\\Local\\Temp"], "safety": "clean", "page": "clean"},
  {"id": "ai_cache", "match": ["~\\.cache\\huggingface", "~\\.ollama", "~\\.cache\\lm-studio", "~\\.lmstudio", "~\\.cache\\modelscope", "~\\.cache\\torch", "~\\.cache\\whisper"], "safety": "clean", "page": "ai"},
  {"id": "dev_cache", "match": ["~\\.cache", "~\\.npm", "~\\.gradle", "~\\.m2", "~\\.nuget", "~\\.cargo", "%LOCALAPPDATA%\\pip", "%LOCALAPPDATA%\\npm-cache", "%LOCALAPPDATA%\\uv", "%LOCALAPPDATA%\\ms-playwright"], "safety": "clean", "page": "clean"},
  {"id": "browser_data", "match": ["%LOCALAPPDATA%\\Google\\Chrome", "%LOCALAPPDATA%\\Microsoft\\Edge", "%LOCALAPPDATA%\\BraveSoftware", "%APPDATA%\\Mozilla"], "safety": "careful", "page": "clean"},
  {"id": "wsl", "match": ["%LOCALAPPDATA%\\Docker", "%LOCALAPPDATA%\\Packages\\*\\LocalState\\ext4.vhdx"], "safety": "careful"},
  {"id": "store_apps", "match": ["%LOCALAPPDATA%\\Packages", "%ProgramFiles%\\WindowsApps"], "safety": "careful", "page": "software"},
  {"id": "programs", "match": ["%ProgramFiles%", "%ProgramFiles(x86)%", "%LOCALAPPDATA%\\Programs", "*:\\Program Files", "*:\\Program Files (x86)"], "safety": "careful", "page": "software"},
  {"id": "programdata", "match": ["%ProgramData%"], "safety": "careful"},
  {"id": "chat", "match": ["~\\Documents\\WeChat Files", "~\\Documents\\xwechat_files", "~\\Documents\\Tencent Files", "*:\\WeChat Files", "*:\\xwechat_files", "*:\\Tencent Files", "~\\AppData\\Roaming\\Tencent"], "safety": "careful"},
  {"id": "games", "match": ["*\\steamapps", "*:\\SteamLibrary", "*:\\WeGameApps", "*:\\Epic Games", "%ProgramFiles%\\Epic Games", "%ProgramFiles(x86)%\\Steam"], "safety": "careful", "page": "software"},
  {"id": "downloads", "match": ["~\\Downloads"], "safety": "user"},
  {"id": "user_files", "match": ["~\\Documents", "~\\Desktop", "~\\Pictures", "~\\Videos", "~\\Music", "~\\OneDrive*"], "safety": "user"},
  {"id": "appdata_local", "match": ["%LOCALAPPDATA%"], "safety": "careful", "page": "clean"},
  {"id": "appdata_roaming", "match": ["%APPDATA%"], "safety": "careful", "page": "clean"},
  {"id": "appdata", "match": ["~\\AppData"], "safety": "careful", "page": "clean"},
  {"id": "profile", "match": ["~"], "safety": "user"},
  {"id": "users", "match": ["%SystemDrive%\\Users"], "safety": "user"}
 ],
 "types": {"video": "user", "image": "user", "audio": "user", "document": "user", "archive": "user", "installer": "user", "diskimage": "user", "model": "careful", "program": "keep", "cache": "careful", "other": "careful"}
}
